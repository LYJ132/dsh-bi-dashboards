# 复制为 .env 并填入真实值；.env 不入库，本示例只写占位符与安全的非敏感默认值。
# 与 docs/docker-windows/docker-compose.yml 配套使用。

DB_HOST=biz-postgres
DB_PORT=5432
DB_NAME=unmanned_supermarket

# ↓↓ 必填：替换尖括号占位符，不留真实值在示例文件里 ↓↓
DB_USER=<postgres 账户名，如 appuser>
DB_PASSWORD=<与 biz-postgres 一致的高强度密码>

# 连接池（受控上限，避免挤爆数据库）
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
