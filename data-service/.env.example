# 数据库连接（容器内用 biz-postgres，宿主机手动跑改为 localhost）
DB_HOST=biz-postgres
DB_PORT=5432
DB_NAME=unmanned_supermarket
DB_USER=appuser
# 必填，无默认值：请通过密钥/环境变量注入真实口令，切勿提交明文密码。
# 未设置或使用占位符时，服务启动即失败（见 config.py）。
DB_PASSWORD=

# 连接池（受控上限，避免挤爆数据库）
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# ---- AI 看板生成（LLM）----
# Agnes 平台（OpenAI 兼容协议）
LLM_API_KEY=
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.5-flash
LLM_MAX_TOKENS=65536

# Phase1 数据访问 API 地址（容器内用服务名）
DATA_API_URL=http://data-access-api:8600

# 服务端口
PORT=8600
